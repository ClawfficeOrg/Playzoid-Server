# Playzoid Server — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# Server
HOST=127.0.0.1
PORT=8080

# Database
DATABASE_URL=mysql://playzoid:password@localhost:3306/playzoid_dev

# JWT
JWT_SECRET=changeme_at_least_32_characters_long
JWT_EXPIRY_SECONDS=3600

# Redis
REDIS_URL=redis://localhost:6379

# Logging (e.g. info, debug, playzoid_server=debug)
RUST_LOG=info
